{
  "expo": {
    "name": "Sealcard",
    "slug": "sealcard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "sealcard",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.sealcard.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "카드를 밀봉하기 위해 카메라로 사진을 찍습니다.",
        "NSLocationWhenInUseUsageDescription": "카드에 장소 스탬프를 넣을 때만 현재 위치를 사용합니다. 서버로 전송하지 않습니다."
      }
    },
    "android": {
      "package": "app.sealcard.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F0F0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "카드를 밀봉하기 위해 카메라로 사진을 찍습니다."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "카드에 장소 스탬프를 넣을 때만 현재 위치를 사용합니다. 서버로 전송하지 않습니다.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "배경화면·공유용 전시 이미지를 저장합니다.",
          "savePhotosPermission": "배경화면·공유용 전시 이미지를 저장합니다.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "a1f47fd7-8367-42d1-b12e-3cf045cadba3"
      }
    },
    "owner": "hwemochung"
  }
}
